# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
backend/.env
backend/*.db

# The exported model is committed so the repo runs without retraining (~1.6 MB).
# Datasets are not: they are large and may contain participant data.
ml/data/**
!ml/data/README.md
!ml/data/templates/**
# Results: metrics, logs and plots are committed as evidence; the bulky
# intermediates (windowed datasets, duplicate model weights) are not.
ml/results/**/sequences.npz
ml/results/**/baseline.joblib
ml/results/**/*.keras
ml/models/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/public/mediapipe/
frontend/.env.local
*.tsbuildinfo

# Raw downloaded source datasets (re-download; see backend/app/data/README.md)
data_sources/
