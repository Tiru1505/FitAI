# Leave VITE_API_BASE_URL empty in development: Vite proxies /api (including WebSockets) to the backend.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000
# MediaPipe pose model (downloaded by the browser). The "lite" model is fastest; "full" is more accurate.
VITE_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/latest/pose_landmarker_lite.task
